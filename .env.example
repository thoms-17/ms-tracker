# Copie ce fichier en `.env` (gitignoré) pour le dev, ou règle ces variables dans
# l'admin AlwaysData pour la prod. Toutes ont un défaut adapté au dev local.

# --- Clé TMDB (obligatoire pour recherche / tendances / enrichissement) -------
TMDB_API_KEY=

# --- Base de données ----------------------------------------------------------
# Dev : laisser vide → ./data/tvtime.db. Prod : chemin ABSOLU persistant.
# TVTIME_DB_PATH=/home/<compte>/tvtime/data/tvtime.db

# Amorçage auto depuis les JSON TV Time locaux (dev=1). En prod : 0.
TVTIME_SEED_ON_EMPTY=1

# --- Sécurité cookies ---------------------------------------------------------
# Dev/HTTP local : 0. Prod/HTTPS : 1 (sinon le navigateur refuse le cookie Secure).
TVTIME_SECURE_COOKIES=0

# --- URL publique (liens dans les emails) -------------------------------------
# Dev : http://localhost:5173. Prod : https://<ton-app>.alwaysdata.net
TVTIME_BASE_URL=http://localhost:5173

# --- CORS (laisser vide : inutile en même origine) ----------------------------
# TVTIME_CORS_ORIGINS=https://exemple.com,https://autre.com

# --- Envoi d'emails (vérif inscription / reset mot de passe) -------------------
# Laisser vide en dev → les liens sont affichés dans la console.
# TVTIME_SMTP_HOST=smtp.gmail.com
# TVTIME_SMTP_PORT=587
# TVTIME_SMTP_USER=ton.email@gmail.com
# TVTIME_SMTP_PASSWORD=mot-de-passe-application
# TVTIME_SMTP_FROM=ton.email@gmail.com
# TVTIME_SMTP_TLS=1
